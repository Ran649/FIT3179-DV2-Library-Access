{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 880,
  "height": 560,

  "title": {
    "text": "Socioeconomic Disadvantage and Library Access",
    "subtitle": "Access values are square-root scaled to reveal low-access SA2 patterns",
    "anchor": "middle",
    "fontSize": 26,
    "subtitleFontSize": 14
  },

  "data": {
    "url": "data/processed/master_sa2.csv"
  },

  "transform": [
    {
      "calculate": "pow(toNumber(datum.libraries_per_10000) + 0.01, 0.5)",
      "as": "access_display"
    },
    {
      "calculate": "datum.IRSD_decile <= 4 && datum.libraries_per_10000 < 0.1 ? 'Low SEIFA + low access' : datum.IRSD_decile <= 4 ? 'Low SEIFA with some access' : datum.libraries_per_10000 < 0.1 ? 'Higher SEIFA but no local library' : 'Higher access'",
      "as": "risk_group"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "stroke": "white",
        "strokeWidth": 0.7,
        "clip": true
      },
      "encoding": {
        "x": {
          "field": "IRSD_score",
          "type": "quantitative",
          "title": "IRSD Score: lower = more disadvantaged",
          "scale": {
            "domain": [650, 1150]
          }
        },
        "y": {
          "field": "access_display",
          "type": "quantitative",
          "title": "Library access intensity (sqrt scaled)",
          "scale": {
            "domain": [0, 1]
          }
        },
        "size": {
          "field": "population",
          "type": "quantitative",
          "scale": {
            "range": [100, 260]
          },
          "legend": null
        },
        "color": {
          "field": "risk_group",
          "type": "nominal",
          "title": "Access risk group",
          "scale": {
            "domain": [
              "Low SEIFA + low access",
              "Low SEIFA with some access",
              "Higher SEIFA but no local library",
              "Higher access"
            ],
            "range": [
              "#b24a2b",
              "#d39b26",
              "#7f9fb0",
              "#4f8f7d"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 4
          }
        },
        "tooltip": [
          {"field": "SA2_NAME21", "type": "nominal", "title": "SA2 Area"},
          {"field": "population", "type": "quantitative", "title": "Population", "format": ","},
          {"field": "IRSD_score", "type": "quantitative", "title": "IRSD Score"},
          {"field": "IRSD_decile", "type": "ordinal", "title": "IRSD Decile"},
          {"field": "library_count", "type": "quantitative", "title": "Library Count"},
          {"field": "libraries_per_10000", "type": "quantitative", "title": "Libraries per 10,000 residents", "format": ".2f"},
          {"field": "risk_group", "type": "nominal", "title": "Risk Group"}
        ]
      }
    },

    {
      "data": {"values": [{"x": 900}]},
      "mark": {"type": "rule", "strokeDash": [5, 5], "stroke": "#777", "opacity": 0.7},
      "encoding": {"x": {"field": "x", "type": "quantitative"}}
    },

    {
      "data": {"values": [{"y": 0.33}]},
      "mark": {"type": "rule", "strokeDash": [5, 5], "stroke": "#777", "opacity": 0.7},
      "encoding": {"y": {"field": "y", "type": "quantitative"}}
    },

    {
      "data": {
        "values": [
          {"IRSD_score": 700, "access_display": 0.42, "label": "Higher cultural desert risk"},
          {"IRSD_score": 980, "access_display": 0.42, "label": "Better library access"}
        ]
      },
      "mark": {"type": "text", "align": "left", "fontSize": 13, "fontWeight": "bold", "color": "#333"},
      "encoding": {
        "x": {"field": "IRSD_score", "type": "quantitative"},
        "y": {"field": "access_display", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ],

  "config": {
    "background": "#f7f4ef",
    "view": {"stroke": null}
  }
}