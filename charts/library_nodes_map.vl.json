{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 760,
  "height": 560,
  "title": {
    "text": "Library Service Nodes Across Greater Melbourne",
    "subtitle": "Proportional symbol map showing where library services are concentrated",
    "anchor": "middle",
    "fontSize": 22,
    "subtitleFontSize": 13
  },
  "projection": {
    "type": "mercator",
    "center": [145.0, -37.85],
    "scale": 24000
  },
  "layer": [
    {
      "data": {
        "url": "data/processed/melbourne_sa2_wgs84.json",
        "format": { "type": "json", "property": "features" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef3ef",
        "stroke": "#9fb7b3",
        "strokeWidth": 0.55
      }
    },
    {
      "data": {
        "url": "data/processed/library_nodes.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.88,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": { "field": "x", "type": "quantitative" },
        "latitude": { "field": "y", "type": "quantitative" },
        "size": {
          "field": "library_count",
          "type": "quantitative",
          "title": "Libraries in SA2",
          "scale": { "range": [90, 950] }
        },
        "color": {
          "field": "library_count",
          "type": "quantitative",
          "scale": { "scheme": "teals" },
          "legend": null
        },
        "tooltip": [
          { "field": "SA2_NAME21", "type": "nominal", "title": "SA2 Area" },
          { "field": "library_count", "type": "quantitative", "title": "Library Count" }
        ]
      }
    }
  ],
  "config": {
    "background": "#f7f4ef",
    "view": { "stroke": null },
    "legend": { "labelFontSize": 11, "titleFontSize": 12 }
  }
}