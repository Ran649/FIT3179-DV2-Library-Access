{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 800,
  "height": 560,

  "title": {
    "text": "Library Service Nodes Across Greater Melbourne",
    "subtitle": "Proportional symbols show SA2 areas with one or more public libraries",
    "anchor": "center",
    "fontSize": 24,
    "subtitleFontSize": 15
  },

  "projection": {
    "type": "identity",
    "reflectY": true
  },

  "layer": [
    {
      "data": {
        "url": "data/raw/melbourne_sa2.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#dde8e4",
        "stroke": "#b0c8c0",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/processed/library_nodes.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.86,
        "stroke": "#dff4f4",
        "strokeWidth": 1.1
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "size": {
          "field": "library_count",
          "type": "quantitative",
          "title": "Libraries in SA2",
          "scale": {
            "range": [28, 260]
          },
          "legend": {
            "orient": "right",
            "title": "Libraries in SA2"
          }
        },
        "color": {
          "field": "library_count",
          "type": "quantitative",
          "title": "Libraries in SA2",
          "scale": {
            "range": [
              "#96c8b8",
              "#2a8878",
              "#1a5060"
            ]
          },
          "legend": {
            "orient": "right",
            "title": "Libraries in SA2",
            "direction": "vertical",
            "gradientLength": 220,
            "gradientThickness": 20,
            "titleAnchor": "middle",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "SA2_NAME21",
            "type": "nominal",
            "title": "SA2 Area"
          },
          {
            "field": "library_count",
            "type": "quantitative",
            "title": "Library Count"
          }
        ]
      }
    }
  ],

  "config": {
    "background": "#f7f4ef",
    "padding": 0,
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}
