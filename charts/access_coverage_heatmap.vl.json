{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 565,
  "height": 400,

  "title": {
    "text": "Library Access: Disadvantage Meets Car Dependency",
    "subtitle": "Mean libraries per 10,000 residents - Low <1.5 cars, Medium 1.5-2.0, High >2.0",
    "anchor": "middle",
    "fontSize": 22,
    "subtitleFontSize": 13
  },

  "data": {
    "url": "../data/processed/master_sa2.csv"
  },

  "transform": [
    {
      "filter": "datum.IRSD_decile > 0 && datum.avg_cars > 0"
    },
    {
      "calculate": "datum.IRSD_decile <= 3 ? 'Deciles 1-3\\n(Most disadvantaged)' : datum.IRSD_decile <= 7 ? 'Deciles 4-7\\n(Middle)' : 'Deciles 8-10\\n(Least disadvantaged)'",
      "as": "irsd_group"
    },
    {
      "calculate": "datum.avg_cars > 2.0 ? 'High' : datum.avg_cars >= 1.5 ? 'Medium' : 'Low'",
      "as": "car_group"
    }
  ],

  "layer": [
    {
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "car_group",
          "type": "ordinal",
          "title": "Average Cars per Household",
          "sort": ["Low", "Medium", "High"],
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelLimit": 100
          }
        },
        "y": {
          "field": "irsd_group",
          "type": "ordinal",
          "title": "Socioeconomic Group",
          "sort": [
            "Deciles 8-10\n(Least disadvantaged)",
            "Deciles 4-7\n(Middle)",
            "Deciles 1-3\n(Most disadvantaged)"
          ],
          "axis": {
            "labelFontSize": 12,
            "labelLimit": 160
          }
        },
        "color": {
          "aggregate": "mean",
          "field": "libraries_per_10000",
          "type": "quantitative",
          "title": "Mean libraries per 10,000",
          "scale": {
            "range": ["#f0e4d0", "#e8b87a", "#d4844a", "#c65f32", "#7a2a12"],
            "domain": [0, 0.25]
          },
          "legend": {
            "format": ".3f",
            "orient": "right",
            "direction": "vertical",
            "gradientLength": 220,
            "gradientThickness": 20,
            "titleAnchor": "middle",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "irsd_group",
            "type": "nominal",
            "title": "Socioeconomic Group"
          },
          {
            "field": "car_group",
            "type": "nominal",
            "title": "Car Ownership"
          },
          {
            "aggregate": "mean",
            "field": "libraries_per_10000",
            "type": "quantitative",
            "title": "Mean libraries per 10,000",
            "format": ".4f"
          },
          {
            "aggregate": "count",
            "field": "SA2_CODE21",
            "type": "quantitative",
            "title": "SA2 areas in cell"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "car_group",
          "type": "ordinal",
          "sort": ["Low", "Medium", "High"]
        },
        "y": {
          "field": "irsd_group",
          "type": "ordinal",
          "sort": [
            "Deciles 8-10\n(Least disadvantaged)",
            "Deciles 4-7\n(Middle)",
            "Deciles 1-3\n(Most disadvantaged)"
          ]
        },
        "text": {
          "aggregate": "mean",
          "field": "libraries_per_10000",
          "type": "quantitative",
          "format": ".3f"
        },
        "color": {
          "condition": {
            "test": "datum.car_group == 'Low'",
            "value": "white"
          },
          "value": "#333333"
        }
      }
    }
  ],

  "config": {
    "background": "#f7f4ef",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#ddd8cf"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11
    }
  }
}