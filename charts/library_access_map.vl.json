{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 760,
  "height": 560,

  "title": {
    "text": "Library Access Across Greater Melbourne",
    "subtitle": "Libraries per 10,000 residents by SA2 area",
    "anchor": "middle",
    "fontSize": 24,
    "subtitleFontSize": 14
  },

  "data": {
    "url": "data/raw/melbourne_sa2.json",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.SA2_CODE21",
      "from": {
        "data": {
          "url": "data/processed/master_sa2.csv"
        },
        "key": "SA2_CODE21",
        "fields": [
          "population",
          "IRSD_score",
          "IRSD_decile",
          "library_count",
          "libraries_per_10000"
        ]
      }
    }
  ],
  "projection": {
    "type": "identity",
    "reflectY": true
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.6
  },
  "encoding": {
    "color": {
      "field": "libraries_per_10000",
      "type": "quantitative",
      "title": "Libraries per 10,000 residents",
      "scale": {
        "range": ["#f0e4d0", "#e8b87a", "#d4844a", "#c65f32", "#7a2a12"],
        "domain": [0, 1],
        "clamp": true
      }
    },
    "tooltip": [
      {
        "field": "properties.SA2_NAME21",
        "type": "nominal",
        "title": "SA2 Area"
      },
      {
        "field": "population",
        "type": "quantitative",
        "title": "Population",
        "format": ","
      },
      {
        "field": "library_count",
        "type": "quantitative",
        "title": "Library Count"
      },
      {
        "field": "libraries_per_10000",
        "type": "quantitative",
        "title": "Libraries per 10,000 residents",
        "format": ".2f"
      },
      {
        "field": "IRSD_score",
        "type": "quantitative",
        "title": "IRSD Score"
      },
      {
        "field": "IRSD_decile",
        "type": "ordinal",
        "title": "IRSD Decile"
      }
    ]
  },
  "config": {
    "background": "#f7f4ef",
    "padding": 0,
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}