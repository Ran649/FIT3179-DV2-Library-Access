{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 680,
  "height": 380,

  "title": {
    "text": "Library Provision by Socioeconomic Decile",
    "subtitle": "Mean libraries per 10,000 residents - averaged across SA2 areas in each IRSD decile",
    "anchor": "middle",
    "fontSize": 22,
    "subtitleFontSize": 13
  },

  "data": {"url": "../data/processed/master_sa2.csv"},

  "transform": [
    {"filter": "datum.IRSD_decile > 0"}
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopRight": 4,
        "cornerRadiusBottomRight": 4
      },
      "encoding": {
        "y": {
          "field": "IRSD_decile",
          "type": "ordinal",
          "title": "IRSD Decile (1 = most disadvantaged)",
          "sort": "descending",
          "axis": {
            "labelExpr": "datum.label == 1 ? '1 (Most disadvantaged)' : datum.label == 10 ? '10 (Least disadvantaged)' : datum.label + ''"
          }
        },
        "x": {
          "aggregate": "mean",
          "field": "libraries_per_10000",
          "type": "quantitative",
          "title": "Mean libraries per 10,000 residents",
          "scale": {"domain": [0, 0.16]}
        },
        "color": {
          "field": "IRSD_decile",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "domain": [1, 10],
            "range": ["#7a2a12", "#1a5060"]
          }
        },
        "tooltip": [
          {"field": "IRSD_decile", "type": "ordinal", "title": "IRSD Decile"},
          {
            "aggregate": "mean",
            "field": "libraries_per_10000",
            "type": "quantitative",
            "title": "Mean libraries per 10,000",
            "format": ".3f"
          },
          {
            "aggregate": "count",
            "field": "SA2_CODE21",
            "type": "quantitative",
            "title": "SA2 areas in decile"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11,
        "color": "#555"
      },
      "encoding": {
        "y": {
          "field": "IRSD_decile",
          "type": "ordinal",
          "sort": "descending"
        },
        "x": {
          "aggregate": "mean",
          "field": "libraries_per_10000",
          "type": "quantitative"
        },
        "text": {
          "aggregate": "mean",
          "field": "libraries_per_10000",
          "type": "quantitative",
          "format": ".3f"
        }
      }
    }
  ],

  "config": {
    "background": "#f7f4ef",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#ddd8cf"
    }
  }
}
