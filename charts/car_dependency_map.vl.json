{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 760,
  "height": 520,

  "title": {
    "text": "Car Dependency Across Greater Melbourne",
    "subtitle": "Average motor vehicles per household by SA2 area",
    "anchor": "center",
    "fontSize": 24,
    "subtitleFontSize": 15
  },

  "data": {
    "url": "data/raw/melbourne_sa2.json",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.SA2_CODE21",
      "from": {
        "data": {
          "url": "data/processed/car_dependency.csv"
        },
        "key": "SA2_CODE21",
        "fields": ["zero_car_pct", "avg_cars"]
      }
    }
  ],
  "projection": {
    "type": "identity",
    "reflectY": true
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.6
  },
  "encoding": {
    "color": {
      "field": "avg_cars",
      "type": "quantitative",
      "title": "Avg cars per household",
      "scale": {
        "range": ["#edf4f2","#b9d5cf","#7faeaa","#4f8487","#2c5f68"],
        "domain": [0.5, 2.7],
        "clamp": true
      },
      "legend": {
        "orient": "right",
        "direction": "vertical",
        "gradientLength": 220,
        "gradientThickness": 20,
        "titleAnchor": "middle",
        "labelFontSize": 11,
        "titleFontSize": 12
      }
    },
    "tooltip": [
      {
        "field": "properties.SA2_NAME21",
        "type": "nominal",
        "title": "SA2 Area"
      },
      {
        "field": "avg_cars",
        "type": "quantitative",
        "title": "Avg cars per household",
        "format": ".2f"
      },
      {
        "field": "zero_car_pct",
        "type": "quantitative",
        "title": "Car-free households",
        "format": ".1%"
      }
    ]
  },
  "config": {
    "background": "#f7f4ef",
    "padding": 0,
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}